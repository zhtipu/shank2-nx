+// shank2-nx: std::filesystem::absolute, except for a newlib device path ("shank2rom:/game_root", a mounted RomFS on the
+// Switch): libstdc++ sees no root there, takes it for relative and prepends the current directory, which breaks it.
+// Such a path is already complete for newlib's stat and fopen.
+inline std::filesystem::path AbsoluteOrDevicePath(const std::filesystem::path& path) {
+  const std::string text = path.string();
